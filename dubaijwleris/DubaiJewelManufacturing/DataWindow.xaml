<Window x:Class="DubaiJewelManufacturing.DataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         WindowState="Maximized"
        xmlns:models="clr-namespace:DubaiJewelManufacturing.Models" xmlns:local="clr-namespace:DubaiJewelManufacturing"
        Icon="/Assets/Images/logo.jpg"
        Title="Admin Powers" Height="600" Width="900" Background="#FFFFFF" FontFamily="Segoe UI">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <local:HeaderControl x:Name="HeaderCtrl" VerticalAlignment="Top" />
        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1" Margin="0,10,0,10">
            <StackPanel.Resources>
                <Style x:Key="RoundedButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="#FADADD"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="#E0A4A4"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="Padding" Value="15,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FFF0F0"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#F08080"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FADADD"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#E57373"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>

            <Button Content="Export Excel File" Width="150" Height="35" Margin="5" Style="{StaticResource RoundedButtonStyle}"   Cursor="Hand" Click="ExportToExcel_Click"/>
            <Button Content="Return to main menu" Width="180" Height="35" Margin="5" Style="{StaticResource RoundedButtonStyle}" Click="NavigateButton_Click"  Cursor="Hand"/>
        </StackPanel>

        <!-- DataGrid -->
        <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5" Padding="5">
            <DataGrid x:Name="ProductsDataGrid"
          AutoGenerateColumns="False"
          HeadersVisibility="Column"
          GridLinesVisibility="All"
          HorizontalGridLinesBrush="#DDDDDD"
          VerticalGridLinesBrush="#DDDDDD"
          RowHeight="35"
          FontSize="14"
          Background="White"
          BorderThickness="0"
          CanUserAddRows="False">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product Type" Width="*" Binding="{Binding ProductType}" />
                    <DataGridTextColumn Header="Carat" Width="80" Binding="{Binding Carat}" />
                    <DataGridTextColumn Header="Weight" Width="100" Binding="{Binding Weight}" />
                    <DataGridTextColumn Header="Barcode format" Width="*" Binding="{Binding Barcodeformat}" />
                    <DataGridTextColumn Header="Serial Number" Width="120" Binding="{Binding SerialNumber}" />
                    <DataGridTextColumn Header="Date" Width="120" Binding="{Binding Date}" />
                    <DataGridTextColumn Header="Time" Width="100" Binding="{Binding Time}" />
                </DataGrid.Columns>
            </DataGrid>

        </Border>
    </Grid>
</Window>
