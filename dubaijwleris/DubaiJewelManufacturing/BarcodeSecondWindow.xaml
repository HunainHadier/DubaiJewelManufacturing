<Window x:Class="DubaiJewelManufacturing.BarcodeSecondWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DubaiJewelManufacturing"
        Title="Dubai Jewel Manufacturing"
        WindowState="Maximized"
        Icon="/Assets/Images/logo.jpg"
        Height="700"
        Width="1000"
        Background="White"
        FontFamily="Segoe UI">

    <!-- ================== RESOURCES ================== -->
    <Window.Resources>
        <!-- TextBox Styles -->
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditableTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyTextBoxStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="IsReadOnly" Value="False"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#FF8C00"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ================== MAIN LAYOUT ================== -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <local:BarcodeformateControl x:Name="BarcodeHeader" Grid.Row="0" Height="60" Background="#F0F0F0" Margin="2,-16,-2,16"/>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left Column: Barcode Preview ===== -->
            <!-- ===== Left Column: Barcode Preview ===== -->
            <StackPanel Grid.Column="0" Margin="0,0,30,0">
                <TextBlock Text="Preview:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                <Viewbox Width="380" Height="160" Stretch="Uniform" Margin="0,0,0,20">
                    <Canvas Width="760"  x:Name="BarcodePreviewCanvas" Height="160" Background="Transparent">

                        <!-- Background -->
                        <Image Source="/Assets/Images/barcode.png"
                   Width="747" Height="188" Canvas.Top="-18"
                   Stretch="Fill" Opacity="0.9" Canvas.Left="-6"/>

                        <!-- Left Side (Arabic Info) -->
                        <Border Width="188" Height="128" Background="White" Opacity="0.9"
                    CornerRadius="5" Canvas.Left="322" Canvas.Top="20">
                            <StackPanel Margin="10,5" FlowDirection="RightToLeft">

                                <!-- Logo + Name -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="جوهرة دبي" TextAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#222" Width="107"/>
                                    <Image Source="/Assets/Images/logo.jpg" Width="24" Height="24" Stretch="Uniform" Margin="0,0,6,0"/>
                                </StackPanel>

                                <!-- Weight -->
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="الوزن :" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="WeightText" Text="-" FontSize="12" Margin="5,0,0,0"/>
                                </StackPanel>

                                <!-- Carat -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="العيار :" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CaratText" Text="-" FontSize="12" Margin="5,0,0,0"/>
                                </StackPanel>

                                <!-- Length -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="الطول :" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LengthText" Text="-" FontSize="12" Margin="5,0,0,0"/>
                                </StackPanel>

                                <!-- Quantity -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="العدد :" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="QuantityText" Text="-" FontSize="12" Margin="5,0,0,0"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- Right Side (Barcode with Logo) -->
                        <Border Width="175" Height="120" Background="White" Opacity="0.9"
                    CornerRadius="5" Canvas.Left="539" Canvas.Top="17">
                            <StackPanel Margin="10,5" HorizontalAlignment="Center">
                                <!-- Logo Row -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Image Source="/Assets/Images/logo.jpg" Width="24" Height="24"/>
                                    <TextBlock Text="جوهرة دبي"
                   TextAlignment="Center"
                   FontSize="14"
                   FontWeight="Bold"
                   Foreground="#222"
                   Width="101"/>
                                </StackPanel>

                                <!-- Barcode Image (Bigger Height) -->
                                <Image x:Name="BarcodeImage"
           Width="180"
           Height="200"
           Stretch="Uniform"/>
                            </StackPanel>

                        </Border>

                    </Canvas>
                </Viewbox>
            </StackPanel>

            <!-- ===== Right Column: Form ===== -->
            <StackPanel Grid.Column="1">
                <!-- Product Type -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Product Type:" FontSize="14" VerticalAlignment="Center"/>
                    <TextBox x:Name="ProductTypeTextBox" Grid.Column="1" Height="35" IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                </Grid>

                <!-- Barcode Scanner -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Barcode scanner:" FontSize="14" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Height="35" Style="{StaticResource EditableTextBoxStyle}" ToolTip="Scan or enter barcode"/>
                </Grid>

                <!-- Manual Selection -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Manual selection:" FontSize="14" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ManualSelectionComboBox" Grid.Column="1" SelectionChanged="ManualSelectionComboBox_SelectionChanged"
                              Height="35" Style="{StaticResource ComboBoxStyle}" />
                </Grid>

                <!-- Weight & Length -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Weight:" FontSize="14" Margin="0,0,0,5"/>
                        <TextBox x:Name="WeightTextBox" Height="35" TextChanged="WeightTextBox_TextChanged" Style="{StaticResource EditableTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Length:" FontSize="14" Margin="0,0,0,5"/>
                        <TextBox x:Name="LengthTextBox" Height="35" TextChanged="LengthTextBox_TextChanged" Style="{StaticResource EditableTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Carat & Quantity -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Carat:" FontSize="14" Margin="0,0,0,5"/>
                        <TextBox x:Name="CaratTextBox" Height="35" IsReadOnly="True" Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Quantity:" FontSize="14" Margin="0,0,0,5"/>
                        <TextBox x:Name="QuantityTextBox" Height="35"  TextChanged="QuantityTextBox_TextChanged" Style="{StaticResource EditableTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ReadingEnabledButton"
            Content="Reading is Disabled"
            Width="150"
            Height="40"
            Background="Red"
            Foreground="White"
            IsEnabled="False"
            Style="{StaticResource PrimaryButtonStyle}"
            Margin="0,0,10,0"/>

                    <Button x:Name="PrintBarcodeButton"
            Content="Test Print"
            Width="120"
            Height="40"
            Click="PrintBarcode_Click"
            Style="{StaticResource WarningButtonStyle}"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
