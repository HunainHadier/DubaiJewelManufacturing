<UserControl x:Class="DubaiJewelManufacturing.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="60" Width="Auto">
    <Border Background="#F5F5F5" BorderBrush="#B0B0B0" BorderThickness="0,0,0,1">
        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- Left: Title -->
                <ColumnDefinition Width="Auto" />
                <!-- Right: User Info -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: App Title -->
            <TextBlock Text="Admin Powers"
                       FontSize="18" FontWeight="Bold" Foreground="#333"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>

            <!-- RIGHT: User Info + Menu -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" 
                        VerticalAlignment="Center" Margin="0,0,20,0">
                <Button x:Name="UserMenuButton" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="UserMenuButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}" 
               FontSize="14" FontWeight="SemiBold" Foreground="#333" 
               Margin="0,0,8,0"
               VerticalAlignment="Center"/>
                        <Border Background="White" CornerRadius="15" Width="30" Height="30"
            BorderBrush="#2E8B57" BorderThickness="1.5"
            VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="16"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Foreground="#2E8B57"/>
                        </Border>
                    </StackPanel>

                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Logout" Click="Logout_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
