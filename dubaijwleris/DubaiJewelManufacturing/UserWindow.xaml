<Window x:Class="DubaiJewelManufacturing.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DubaiJewelManufacturing.Models" xmlns:local="clr-namespace:DubaiJewelManufacturing"
        Icon="/Assets/Images/logo.jpg"
         WindowState="Maximized"
        Title="Admin Powers" Height="600" Width="900" Background="#FFFFFF" FontFamily="Segoe UI">


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <local:HeaderControl x:Name="HeaderCtrl" VerticalAlignment="Top" />
        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1" Margin="0,10,0,10">

            <StackPanel.Resources>
                <!-- Rounded Button Style with Hover and Click Effect -->
                <Style x:Key="RoundedButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="#FADADD"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- Hover Effect -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FFF0F0"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#F08080"/>
                                    </Trigger>
                                    <!-- Pressed/Click Effect -->
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FADADD"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#E57373"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>

            <!-- Buttons with Rounded Style -->
            <Button Content="Import Excel File" Width="150" Height="35" 
            Margin="5" Padding="5"
                    Cursor="Hand"
                     Click="ImportExcel_Click"
            Style="{StaticResource RoundedButtonStyle}"/>

            <Button Content="Export Excel File" Width="150" Height="35" 
            Margin="5" Padding="5"
                    Cursor="Hand"
                    Click="ExportToExcel_Click"
            Style="{StaticResource RoundedButtonStyle}" />

            <Button Content="Save" Width="100" Height="35" 
            Margin="5" Padding="5"
                    Cursor="Hand"
                       Click="SaveImportedData_Click"
            Style="{StaticResource RoundedButtonStyle}"/>

            <Button Content="Return to main menu" Width="180" Height="35" 
            Margin="5" Padding="5"
                    Cursor="Hand"
            Style="{StaticResource RoundedButtonStyle}" Click="NavigateButton_Click"/>

        </StackPanel>


        <!-- DataGrid -->
        <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5" Padding="5">
            <DataGrid x:Name="UsersDataGrid"
          AutoGenerateColumns="False"
          HeadersVisibility="Column"
          GridLinesVisibility="All"
          HorizontalGridLinesBrush="#DDDDDD"
          VerticalGridLinesBrush="#DDDDDD"
          RowHeight="35" FontSize="14"
          Background="White"
          BorderThickness="0">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Width="*" Binding="{Binding Username}" />
                    <DataGridTextColumn Header="Role" Width="150" Binding="{Binding Role}" />
                    <DataGridTextColumn Header="User ID" Width="150" Binding="{Binding UserID}" />
                    <DataGridTextColumn Header="User Password" Width="200" Binding="{Binding Password}" />

                    <!-- Edit Button Column -->
                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="+" FontSize="20" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Width="25" Height="25" Background="Transparent" BorderThickness="0" Click="Edit_User">
                                    <Image Source="/Assets/Images/editing.png" Stretch="Uniform"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Border>

    </Grid>
</Window>
