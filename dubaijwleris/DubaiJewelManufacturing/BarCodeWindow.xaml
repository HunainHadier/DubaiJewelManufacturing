<Window x:Class="DubaiJewelManufacturing.BarCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DubaiJewelManufacturing"
          Icon="/Assets/Images/logo.jpg"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="BarCode Management System" 
        Height="600" Width="900" 
        Background="#F8F9FA"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- CARD STYLE -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E0E0E0" Direction="270" ShadowDepth="2" Opacity="0.3" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN GRAY BUTTON -->
        <Style x:Key="ModernGrayButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#6C757D"
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5A6268"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#495057"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN BLUE BUTTON -->
        <Style x:Key="ModernBlueButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#007BFF"
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0056B3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#004085"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN ORANGE BUTTON -->
        <Style x:Key="ModernOrangeButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#FF8C00"
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF7300"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E66500"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN TEXTBOX -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#80BDFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007BFF"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8F9FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN COMBOBOX -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <local:BarcodeformateControl x:Name="BarcodeHeader" Grid.Row="0" Height="60" Background="#F0F0F0" Margin="2,-16,-2,16"/>

        <!-- MAIN CONTENT -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="30" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL -->
                <!-- LEFT PANEL -->
                <!-- LEFT PANEL -->
                <StackPanel Grid.Column="0" Margin="0,0,30,0">

                    <!-- PREVIEW -->
                    <GroupBox x:Name="BarcodePreviewGroupBox" Header="Barcode Preview" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,25">
                        <Border BorderBrush="#E9ECEF" BorderThickness="2" Background="#FFFFFF"
        CornerRadius="6" Padding="10" Height="160" Width="260">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                <!-- Top Row: Company Name + Logo + Arabic Text -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                    <TextBlock Text="Dubai Jewel" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Image Source="/Assets/Images/logo.jpg" Width="14" Height="14" Margin="5,0"/>
                                    <TextBlock Text="جوهرة دبي" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                                </StackPanel>

                                <!-- Barcode Image -->
                                <Image x:Name="BarcodeImage" Width="220" Height="45" Stretch="Uniform" Margin="0,0,0,8"/>

                                <!-- Bottom Row: 21K, Code, Weight -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CaratText" Text="21K" FontSize="11" FontWeight="Medium" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="BarcodeCodeText" Text="1400001208" FontSize="11" FontWeight="Medium" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="WeightText" Text="5.62g" FontSize="11" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </GroupBox>

                    <!-- PRODUCT INFO -->
                    <GroupBox Header="Product Information" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,25">
                        <StackPanel Margin="0,10,0,0">
                            <!-- Weight -->
                            <TextBlock Text="Weight:" FontSize="13" Foreground="#495057" Margin="0,0,0,6" FontWeight="Medium"/>
                            <TextBox x:Name="WeightTextBox" Width="150" Height="38" 
                     HorizontalAlignment="Left"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"/>

                            <!-- Carat -->
                            <TextBlock Text="Carat:" FontSize="13" Foreground="#495057" Margin="10,10,0,6" FontWeight="Medium"/>
                            <TextBox x:Name="CaratTextBox" Width="150" Height="38"
                     HorizontalAlignment="Left"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"/>

                            <!-- Return Button -->
                            <Button x:Name="ReturnToMainMenuButton" Content="Return to Main Menu"
                    Width="220" Height="42"
                    HorizontalAlignment="Left"
                    Margin="0,15,0,0"
                    Style="{StaticResource ModernGrayButton}"
                    Click="returntomainmenu"
                    Visibility="Collapsed"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!-- RIGHT PANEL -->
                <StackPanel Grid.Column="1" Margin="30,0,0,0">

                    <!-- Scanner Config -->
                    <GroupBox Header="Scanner Configuration" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,25">
                        <StackPanel Margin="0,10,0,0">
                            <!-- Product Type -->
                            <TextBlock Text="Product Type:" FontSize="13" Foreground="#495057" Margin="0,0,0,6" FontWeight="Medium"/>
                            <TextBox x:Name="ProductTypeTextBox"
         Width="220" Height="38"
  
         HorizontalAlignment="Left"
         HorizontalContentAlignment="Center"
         VerticalContentAlignment="Center"/>


                            <!-- Barcode Scanner Input -->
                            <TextBlock Text="Barcode Scanner:" FontSize="13" Foreground="#495057" Margin="0,15,0,6" FontWeight="Medium"/>
                            <TextBox x:Name="BarcodeInput" Width="220" Height="38" 
                                     Style="{StaticResource ModernTextBox}"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"/>

                            <!-- Manual Selection -->
                            <TextBlock Text="Manual Selection:" FontSize="13" Foreground="#495057" Margin="0,15,0,6" FontWeight="Medium"/>
                            <ComboBox x:Name="ManualSelectionComboBox"
          Width="220" Height="38"
          Style="{StaticResource ModernComboBox}"
          HorizontalAlignment="Left"
          DisplayMemberPath="ProductType"
          SelectionChanged="ManualSelectionComboBox_SelectionChanged"/>


                        </StackPanel>
                    </GroupBox>

                    <!-- Action Buttons -->
                    <GroupBox Header="Actions" FontSize="14" FontWeight="SemiBold">
                        <StackPanel HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Button x:Name="ReadingEnabledButton"
        Content="🔍 Reading is Disabled"
        Width="240"
        Height="48"
        Margin="0,0,0,12"
        Background="Red"
        Foreground="White"
        BorderBrush="Red"
        IsEnabled="False"
        Click="ReadingEnabledButton_Click"/>


                            <Button Content="🖨️ Test Print" Width="240" Height="48"
                                    Style="{StaticResource ModernOrangeButton}"
                                    Click="PrintBarcode_Click"
                                    />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
            
        </Border>
    </Grid>
</Window>
