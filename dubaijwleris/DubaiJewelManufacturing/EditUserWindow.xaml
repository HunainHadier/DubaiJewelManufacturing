<Window x:Class="DubaiJewelManufacturing.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit User" Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#80000000"  
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Modal Card with Drop Shadow -->
        <Border Background="White" 
                CornerRadius="8" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1"
                Padding="25">
            <Border.Effect>
                <DropShadowEffect Color="Black" 
                                  Direction="315" 
                                  ShadowDepth="8" 
                                  Opacity="0.3" 
                                  BlurRadius="15"/>
            </Border.Effect>

            <Grid Width="380">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Text="Edit User" 
                           Grid.Row="0" 
                           HorizontalAlignment="Left"
                           FontSize="16" 
                           FontWeight="Bold"
                           Foreground="#333333"/>

                <!-- Current Values Section -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <!-- Username Current -->
                    <TextBlock Text="Username now :" 
                               Grid.Column="0" Grid.Row="0"
                               FontSize="12" 
                               Foreground="#555555"
                               VerticalAlignment="Bottom"/>
                    <TextBox x:Name="txtCurrentUsername" 
                             Grid.Column="0" Grid.Row="1"
                             Text="احمد حسن"
                             IsReadOnly="True" 
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Background="#F8F8F8"
                             BorderBrush="#DDDDDD"
                             BorderThickness="1"
                             Height="28"
                             FontSize="12"/>

                    <!-- Role Current -->
                    <TextBlock Text="Role now :" 
                               Grid.Column="1" Grid.Row="0"
                               FontSize="12" 
                               Foreground="#555555"
                               VerticalAlignment="Bottom"
                               Margin="10,0,0,0"/>
                    <TextBox x:Name="txtCurrentRole" 
                             Grid.Column="1" Grid.Row="1"
                             Text="Admin"
                             IsReadOnly="True" 
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Background="#F8F8F8"
                             BorderBrush="#DDDDDD"
                             BorderThickness="1"
                             Height="28"
                             FontSize="12"
                             Margin="10,0,0,0"/>
                </Grid>

                <!-- New Values Section -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <!-- Username New -->
                    <TextBlock Text="Change to :" 
                               Grid.Column="0" Grid.Row="0"
                               FontSize="12" 
                               Foreground="#555555"
                               VerticalAlignment="Bottom"/>
                    <TextBox x:Name="txtNewUsername" 
                             Grid.Column="0" Grid.Row="1"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             BorderBrush="#DDDDDD"
                             BorderThickness="1"
                             Height="28"
                             FontSize="12"/>

                    <!-- Role New -->
                    <TextBlock Text="Change to :" 
                               Grid.Column="1" Grid.Row="0"
                               FontSize="12" 
                               Foreground="#555555"
                               VerticalAlignment="Bottom"
                               Margin="10,0,0,0"/>
                    <TextBox x:Name="txtNewRole" 
                             Grid.Column="1" Grid.Row="1"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             BorderBrush="#DDDDDD"
                             BorderThickness="1"
                             Height="28"
                             FontSize="12"
                             Margin="10,0,0,0"/>
                </Grid>

                <!-- User ID and Password Section -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <!-- User ID Current -->
                    <TextBlock Text="User ID now :" 
                               Grid.Column="0" Grid.Row="0"
                               FontSize="12" 
                               Foreground="#555555"
                               VerticalAlignment="Bottom"/>
                    <TextBox x:Name="txtCurrentUserID" 
                             Grid.Column="0" Grid.Row="1"
                             Text="108"
                             IsReadOnly="True" 
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Background="#F8F8F8"
                             BorderBrush="#DDDDDD"
                             BorderThickness="1"
                             Height="28"
                             FontSize="12"/>

                    <!-- User Password Current -->
                    <TextBlock Text="User Password now :" 
                               Grid.Column="1" Grid.Row="0"
                               FontSize="12" 
                               Foreground="#555555"
                               VerticalAlignment="Bottom"
                               Margin="10,0,0,0"/>
                    <TextBox x:Name="txtCurrentPassword" 
                             Grid.Column="1" Grid.Row="1"
                             Text="315789"
                             IsReadOnly="True" 
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Background="#F8F8F8"
                             BorderBrush="#DDDDDD"
                             BorderThickness="1"
                             Height="28"
                             FontSize="12"
                             Margin="10,0,0,0"/>
                </Grid>

                <!-- New User ID and Password Section -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <!-- User ID New -->
                    <TextBlock Text="Change to :" 
                               Grid.Column="0" Grid.Row="0"
                               FontSize="12" 
                               Foreground="#555555"
                               VerticalAlignment="Bottom"/>
                    <TextBox x:Name="txtNewUserID" 
                             Grid.Column="0" Grid.Row="1"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             BorderBrush="#DDDDDD"
                             BorderThickness="1"
                             Height="28"
                             FontSize="12"/>

                    <!-- User Password New -->
                    <TextBlock Text="Change to :" 
                               Grid.Column="1" Grid.Row="0"
                               FontSize="12" 
                               Foreground="#555555"
                               VerticalAlignment="Bottom"
                               Margin="10,0,0,0"/>
                    <TextBox x:Name="txtNewPassword" 
                             Grid.Column="1" Grid.Row="1"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             BorderBrush="#DDDDDD"
                             BorderThickness="1"
                             Height="28"
                             FontSize="12"
                             Margin="10,0,0,0"/>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="10" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <Button Content="Save" 
                            Width="80" 
                            Height="32"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Save_Click"
                            >
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#2E86DE"
                                                    CornerRadius="4"
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="White"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1E5BC6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Cancel" 
                            Width="80" 
                            Height="32"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Margin="10,0,0,0"
                            Click="Cancel_Click" RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="-1.729"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Button.RenderTransform>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#F39C12"
                                                    CornerRadius="4"
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="White"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter  Property="Background" Value="#D68910"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Delete Button -->
                <Button Content="Delete" 
                        Grid.Row="12"
                        Width="218" 
                        Height="35"
                        Background="Red" 
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        Click="Delete_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#C0392B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>