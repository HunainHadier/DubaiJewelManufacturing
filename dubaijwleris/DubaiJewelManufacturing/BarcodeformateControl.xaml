<UserControl x:Class="DubaiJewelManufacturing.BarcodeformateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="60" Width="Auto"
             Loaded="UserControl_Loaded">

    <Border Background="#F9F9F9"
            BorderBrush="#D0D0D0"
            BorderThickness="0,0,0,2"
            Height="60"
            HorizontalAlignment="Stretch">

        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Barcode Format Dropdown -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="Barcode format :" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#333" Margin="0,0,12,0"/>
                <ComboBox x:Name="BarcodeFormatComboBox"
          Width="150"
          Height="34"
          FontSize="13"
          Padding="5,0"
          Background="White"
          BorderBrush="#2E8B57"
          BorderThickness="1.2"
          SelectedIndex="0"
          IsEditable="False"
          HorizontalContentAlignment="Center"
          VerticalContentAlignment="Center"
          DropDownClosed="BarcodeFormatComboBox_DropDownClosed">

                    <ComboBoxItem Content="Normal" Cursor="Hand"/>
                    <ComboBoxItem Content="Chain" Cursor="Hand"/>
                </ComboBox>

            </StackPanel>

            <!-- RIGHT: User Info -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                <!-- UserName -->
                <TextBlock Text="{Binding UserName, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="SemiBold"
               FontSize="14"
               Foreground="#333"
               VerticalAlignment="Center"
               Margin="0,0,10,0"/>

                <!-- User Icon Button with ContextMenu -->
                <Button x:Name="UserMenuButton"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Cursor="Hand"
            VerticalAlignment="Center">
                    <Border Background="White"
                CornerRadius="15"
                Width="30" Height="30"
                BorderBrush="#2E8B57"
                BorderThickness="1.5">
                        <TextBlock Text="👤"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#2E8B57"/>
                    </Border>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Logout" Click="Logout_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
