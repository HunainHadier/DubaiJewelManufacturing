<Window x:Class="DubaiJewelManufacturing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dubai Jewel Manufacturing"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
         WindowState="Maximized"
        Background="Transparent"
        Height="520" Width="760">

    <Window.Resources>

        <!-- Watermark TextBox -->
        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="Gray"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded TextBox Style -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded PasswordBox Style -->
        <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="6" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border CornerRadius="8" Background="#F6F7FB" BorderBrush="#DDDDDD" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#111111" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- Circular Logo instead of Ellipse -->
                    <Border Width="20" Height="20" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/logo.jpg" Stretch="Fill"/>
                    </Border>

                    <TextBlock Text="Dubai Jewel Manufacturing"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Min & Close Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="35" Height="24" Margin="0,0,2,0"
                            Click="Minimize_Click"
                            Background="Transparent" BorderBrush="Transparent" Foreground="White"
                            ToolTip="Minimize">
                        <Path Data="M 2 0 L 10 0" Stroke="White" StrokeThickness="2"/>
                    </Button>
                    <Button Width="35" Height="24" Margin="0,0,6,0"
                            Click="Close_Click"
                            Background="Transparent" BorderBrush="Transparent" Foreground="White"
                            ToolTip="Close">
                        <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="White" StrokeThickness="2"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Row="0" Margin="0,32,0,24" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- Circular Logo -->
                        <Border Width="50" Height="50" CornerRadius="25" ClipToBounds="True">
                            <Image Source="Assets/Images/logo.jpg" Stretch="Fill"/>
                        </Border>

                        <!-- Text beside logo -->
                        <TextBlock Text="Dubai Jewel Manufacturing"
                   FontSize="24" 
                   FontWeight="SemiBold"
                   Margin="12,0,0,0" 
                   Foreground="#111111"
                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Login Card -->
                <Border Grid.Row="1"
                        Width="420" Padding="32"
                        Background="White" CornerRadius="12"
                        HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.08" ShadowDepth="6" BlurRadius="18"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Login to your account"
                                   FontSize="20" FontWeight="SemiBold"
                                   Margin="0,0,0,24" HorizontalAlignment="Center"/>

                        <!-- ID -->
                        <TextBlock Text="ID" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="IdTextBox"
                                 Style="{StaticResource RoundedTextBoxStyle}"
                                 Tag="Enter ID"/>

                        <!-- Password -->
                        <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource RoundedPasswordBoxStyle}"/>

                        <!-- Sign in -->
                        <Button Content="Sign in"
                                Height="36" FontWeight="SemiBold"
                                Foreground="White" Cursor="Hand"
                                Click="NavigateButton_Click" >
                            
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#343CFF" Offset="0"/>
                                                <GradientStop Color="#001BFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
